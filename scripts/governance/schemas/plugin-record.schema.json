{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "id", "repository", "installTargets", "classification", "admission", "lifecycle", "visibility", "maintainers", "addedAt"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string" },
    "repository": { "type": "object" },
    "source": { "type": "object" },
    "installTargets": { "type": "array", "minItems": 1 },
    "classification": { "type": "object" },
    "admission": { "type": "object" },
    "lifecycle": { "type": "object" },
    "visibility": { "type": "string" },
    "maintainers": { "type": "array", "minItems": 1 },
    "addedAt": { "type": "string" }
  }
}
